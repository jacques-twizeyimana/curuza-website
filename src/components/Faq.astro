---
const faqs = [
  {
    question: 'What is Curuza?',
    answer: 'Curuza is point-of-sale and inventory software built for shops in Rwanda. It keeps sales, stock, expenses, EBM invoices and tax-readiness records together.',
  },
  {
    question: 'Does Curuza work without internet?',
    answer: 'Yes. Curuza is designed to keep core shop operations running offline and sync relevant records when the connection returns.',
  },
  {
    question: 'Can Curuza issue RRA EBM invoices?',
    answer: 'Curuza is designed to issue EBM invoices from the same sale recorded in the point of sale, reducing separate entry and reconciliation work.',
  },
  {
    question: 'Can I track cartons and individual units?',
    answer: 'Yes. You can receive stock by carton, split it into individual units and let each sale reduce the correct quantity automatically.',
  },
  {
    question: 'Which computers can run Curuza?',
    answer: 'The desktop application is planned for Windows, macOS and Linux, with Kinyarwanda and English support.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<section id="faq" class="section-pad bg-cream-100/60">
  <div class="container-px">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow reveal">Frequently asked questions</span>
      <h2 class="reveal mt-5 font-display text-3xl font-700 tracking-tight text-ink-950 text-balance sm:text-4xl">Questions from Rwandan shop owners</h2>
    </div>
    <div class="mx-auto mt-12 max-w-3xl space-y-3">
      {faqs.map((faq, index) => (
        <details class="reveal group rounded-2xl border border-ink-100 bg-white p-5 shadow-soft" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-700 text-ink-950 [&::-webkit-details-marker]:hidden">
            {faq.question}
            <span class="text-2xl font-normal text-forest-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
